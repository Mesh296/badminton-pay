# Settings for running on a server with Docker. Copy to .env on the server. Never commit .env.

# The exact address people open. Sign-in only works with https:// and a domain name.
PUBLIC_URL=https://caulong.example.com

# Google OAuth client (Google Cloud Console > Google Auth Platform > Clients > Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs the sign-in cookie. At least 32 random characters, e.g. from: openssl rand -base64 32
SESSION_SECRET=

# Comma-separated Google emails that may manage members and fix any entry.
ADMIN_EMAILS=

# Push notifications to phones (optional). One JSON line from: node scripts/generate-vapid-key.mjs
VAPID_KEY=
