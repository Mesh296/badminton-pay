/**
 * Wrangler configuration.
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "badminton-pay",
	"main": "src/worker/index.ts",
	"compatibility_date": "2026-11-23",
	"assets": {
		// Unknown paths fall back to index.html so hash/SPA routes work.
		"not_found_handling": "single-page-application",
		// The Worker only handles the API; everything else is served as a static asset.
		"run_worker_first": ["/api/*"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "badminton-pay",
			// Replaced with the real id from `wrangler d1 create` at first deploy.
			"database_id": "local-placeholder",
			"migrations_dir": "migrations"
		}
	],
	"observability": {
		"enabled": true
	},
	// The evening debt reminder (src/worker/daily-reminder.ts): 12:00 UTC is 19:00 in Vietnam.
	"triggers": {
		"crons": ["0 12 * * *"]
	},
	"upload_source_maps": true
}
