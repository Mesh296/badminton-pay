{
  "name": "badminton-pay",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:server": "vite build --config vite.server.config.ts",
    "start": "node server-build/server.mjs",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "test:server": "npm run build && npm run build:server && node scripts/smoke-test-node-server.mjs",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && npm run db:migrate:remote && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply badminton-pay --local",
    "db:migrate:remote": "wrangler d1 migrations apply badminton-pay --remote"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@hono/node-server": "^2.1.11",
    "hono": "^4.13.23",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "uqr": "0.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.2",
    "@cloudflare/vitest-plugin": "^1.9.2",
    "@types/node": "^24.19.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^4.1.12",
    "wrangler": "^4.168.0"
  }
}
